# Automatic HTTPS. Caddy fetches + renews a Let's Encrypt cert for DOMAIN,
# redirects http->https, and reverse-proxies to the app container.
# DOMAIN and ACME_EMAIL are injected from the environment (see .env).
#
# Apex-only: add `, www.{$DOMAIN}` after {$DOMAIN} ONLY once a www A record
# exists in DNS — otherwise the www challenge NXDOMAINs and blocks the cert.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd
	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
