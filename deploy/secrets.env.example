# Copy to secrets.env ON THE SERVER, fill real values, then: chmod 600 secrets.env
# NEVER commit the real file. These are read only by the app container.

# Claude (paid) — the active analyst. From console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Gemini (free) — automatic fallback if the Claude key is missing/out of credit.
GEMINI_API_KEY=REPLACE_ME

# FACEIT Data API (server-side key) — enables "Connect FACEIT" auto-sync.
FACEIT_API_KEY=REPLACE_ME

# Optional: force a cheaper model. Leave unset for Claude Opus 4.8.
# CLAUDE_MODEL=claude-sonnet-5
